{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asmfea.local/schema/model/1.0",
  "title": "asmfea neutral model",
  "description": "model.json: the only contract between the SolidWorks add-in and the Python pipeline. Units fixed: mm, N, tonne, s, MPa. Positions and directions in the assembly frame unless stated. study.json uses the same schema with every top-level key optional except schema_version, and is merged over model.json at load time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "materials", "parts"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "source": {"$ref": "#/$defs/source"},
    "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
    "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
    "mates": {"type": "array", "items": {"$ref": "#/$defs/mate"}},
    "welds": {"type": "array", "items": {"$ref": "#/$defs/weld"}, "description": "Weld beads (SolidWorks cosmetic weld beads), schema 1.1"},
    "face_refs": {"type": "array", "items": {"$ref": "#/$defs/face_ref"}},
    "loads": {"type": "array", "items": {"$ref": "#/$defs/load"}},
    "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
    "overrides": {"type": "array", "items": {"$ref": "#/$defs/override"}},
    "hinges": {"type": "array", "items": {"$ref": "#/$defs/hinge"}, "description": "Hinges the user added by choosing concentric cylindrical faces (schema 1.x, D50)"},
    "study": {"$ref": "#/$defs/study"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}, "description": "Problems the add-in found while extracting; the pipeline reports each as a diagnostic"}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["STEP_EXPORT_FAILED", "STEP_CONFIG_INACTIVE", "MATE_ENTITY_UNMATCHED", "MEMBER_PATH_UNKNOWN", "EXTRACT_ITEM_FAILED", "FACE_REF_REMATCHED", "FACE_REF_LOST", "FACE_REF_CHANGED"]},
        "where": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "parts": {"type": "array", "items": {"type": "string"}},
            "faces": {"type": "array", "items": {"type": "string"}}
          }
        },
        "params": {"type": "object", "description": "Values for the catalogue wording, and evidence"}
      }
    },
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assembly"],
      "properties": {
        "assembly": {"type": "string"},
        "configuration": {"type": "string"},
        "sw_version": {"type": "string"},
        "addin_version": {"type": "string"},
        "timestamp": {"type": "string"},
        "view": {
          "type": "object", "additionalProperties": false, "required": ["toward_viewer", "up"],
          "description": "The SolidWorks view at export (assembly frame): the report's plots use it as their main view",
          "properties": {"toward_viewer": {"$ref": "#/$defs/vec3"}, "up": {"$ref": "#/$defs/vec3"}}
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "E", "nu", "density", "yield"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "E": {"type": "number", "exclusiveMinimum": 0, "description": "Young's modulus, MPa"},
        "nu": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.5},
        "density": {"type": "number", "exclusiveMinimum": 0, "description": "tonne/mm^3"},
        "yield": {"type": "number", "exclusiveMinimum": 0, "description": "MPa"},
        "ultimate": {"type": "number", "exclusiveMinimum": 0, "description": "MPa"}
      }
    },
    "body": {
      "type": "object",
      "description": "Descriptors of this body in the PART frame, used to find it among the solids of the STEP file. May be omitted when the part's STEP file holds this one solid only (D53).",
      "additionalProperties": false,
      "required": ["volume", "centroid", "bbox_min", "bbox_max"],
      "properties": {
        "volume": {"type": "number", "exclusiveMinimum": 0},
        "centroid": {"$ref": "#/$defs/vec3"},
        "bbox_min": {"$ref": "#/$defs/vec3"},
        "bbox_max": {"$ref": "#/$defs/vec3"}
      }
    },
    "weld": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "size", "parts", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "size": {"type": "number", "exclusiveMinimum": 0, "description": "Bead size (fillet leg), mm"},
        "side": {"enum": ["selection", "both_sides", "all_around"]},
        "parts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "Parts owning the path edges or the weld-from/to faces"},
        "path": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 2},
                 "description": "Weld path as polylines, assembly frame, mm"},
        "intermittent": {"type": "object", "additionalProperties": false,
                         "properties": {"length": {"type": "number"}, "gap": {"type": "number"}, "pitch": {"type": "number"}, "staggered": {"type": "boolean"}}},
        "partial": {"type": "object", "description": "A from-to length weld (not supported yet)"}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "material", "step", "geometry_hash", "transform"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["member", "sheet", "solid", "fastener", "weld_bead"]},
        "material": {"type": "string"},
        "step": {"type": "string", "description": "Path relative to the study folder"},
        "body": {"$ref": "#/$defs/body"},
        "geometry_hash": {"type": "string"},
        "transform": {
          "type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16,
          "description": "Row-major 4x4, part frame to assembly frame; translation in elements 3, 7, 11"
        },
        "fixed": {"type": "boolean"},
        "subassembly": {"type": "string", "description": "Top-level sub-assembly the part sits in (schema 1.1); a sub-assembly is treated as rigid, like one multi-body part"},
        "member": {"$ref": "#/$defs/member_data"},
        "sheet": {"$ref": "#/$defs/sheet_data"},
        "fastener": {"$ref": "#/$defs/fastener_data"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "member"}}}, "then": {"required": ["member"]}},
        {"if": {"properties": {"kind": {"const": "sheet"}}}, "then": {"required": ["sheet"]}},
        {"if": {"properties": {"kind": {"const": "fastener"}}}, "then": {"required": ["fastener"]}}
      ]
    },
    "member_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "path", "clean_spans"],
      "properties": {
        "profile": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["SHS", "RHS", "CHS", "angle", "channel", "I", "flat", "round", "other"]}
          },
          "description": "Profile type plus its dimensions (b, h, t, r_out, d, tw, tf as applicable), part frame, mm; optional source (the weldment profile file)"
        },
        "path": {
          "type": "object",
          "description": "Part frame, mm; clean span positions s are measured from p0 towards p1",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["line", "arc", "other"]},
            "p0": {"$ref": "#/$defs/vec3"},
            "p1": {"$ref": "#/$defs/vec3"},
            "center": {"$ref": "#/$defs/vec3"}
          }
        },
        "clean_spans": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["s0", "s1"],
            "properties": {"s0": {"type": "number"}, "s1": {"type": "number"}}
          }
        }
      }
    },
    "sheet_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thickness", "flat"],
      "properties": {"thickness": {"type": "number", "exclusiveMinimum": 0}, "flat": {"type": "boolean"}}
    },
    "fastener_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "d", "axis"],
      "properties": {
        "type": {"type": "string"},
        "d": {"type": "number", "exclusiveMinimum": 0},
        "axis": {"$ref": "#/$defs/vec3", "description": "Part frame"}
      }
    },
    "mate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "parts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "description": "SolidWorks mate type, e.g. coincident, concentric, lock, hinge, slot, width, slider, distance, angle, limit"},
        "parts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 2},
        "entities": {"type": "array", "items": {"type": "string"}, "description": "face_ref ids or reference-geometry names"},
        "geometry": {"enum": ["plane", "cylinder", "line", "point", "reference", "other"]},
        "point": {"$ref": "#/$defs/vec3"},
        "direction": {"$ref": "#/$defs/vec3"},
        "radius": {"type": "number"},
        "lock_rotation": {"type": "boolean", "description": "concentric, profile center: the mate's Lock rotation option (the hinge is then bonded)"},
        "profile": {"enum": ["round", "other"], "description": "profile center: round profiles turn about their common axis unless locked"},
        "ratio": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "gear: ratio numerator and denominator (in the order of the entities)"},
        "distance_per_rev": {"type": "number", "description": "rack and pinion: rack travel per pinion revolution; screw: lead (mm per revolution)"},
        "reverse": {"type": "boolean", "description": "gear, rack and pinion, screw: the mate's Reverse option"},
        "limits": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "distance, angle: the mate's limits (minimum, maximum; mm or degrees) when it is a limit mate: the parts may move between them"}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "area", "centroid"],
      "properties": {
        "surface": {"enum": ["plane", "cylinder", "cone", "sphere", "torus", "bspline", "other"]},
        "area": {"type": "number", "exclusiveMinimum": 0},
        "centroid": {"$ref": "#/$defs/vec3"},
        "normal": {"$ref": "#/$defs/vec3", "description": "Outward normal at the centroid projection (planes)"},
        "axis": {"$ref": "#/$defs/vec3", "description": "Cylinder/cone axis direction"},
        "radius": {"type": "number"}
      }
    },
    "face_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part"],
      "anyOf": [{"required": ["fingerprint"]}, {"required": ["point"]}],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part": {"type": "string"},
        "persistent_ref": {"type": "string", "description": "Base64 SolidWorks persistent reference"},
        "feature": {"type": "string"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "point": {"$ref": "#/$defs/vec3", "description": "A point on the face, assembly frame (mm): the face is the one the point lies on (D53; for files written without the add-in, e.g. layoutcad). Used when fingerprint is absent"}
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "load_case", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "load_case": {"type": "string"},
        "type": {"enum": ["force", "pressure", "gravity", "remote_force", "hydrostatic"]},
        "faces": {"type": "array", "items": {"type": "string"}},
        "magnitude": {"type": "number", "description": "force, remote_force: N total; pressure: MPa (positive pushes into the face); gravity: mm/s^2; hydrostatic: a load factor on its pressures (1 = as defined)"},
        "direction": {"$ref": "#/$defs/vec3"},
        "point": {"$ref": "#/$defs/vec3", "description": "remote_force: application point, assembly frame (mm)"},
        "offset": {"$ref": "#/$defs/vec3", "description": "remote_force: application point as an offset (mm, assembly axes) from the area-weighted centroid of its faces; used when point is absent. hydrostatic: the top of the fluid, the same way"},
        "density": {"type": "number", "exclusiveMinimum": 0, "description": "hydrostatic: the fluid's density, kg/m^3 (default water, 1000)"},
        "surface_pressure": {"type": "number", "minimum": 0, "description": "hydrostatic: absolute pressure on the top of the fluid, MPa (default 1 atmosphere, 0.101325); 1 atmosphere is taken to act outside, so the faces get the difference"},
        "scale_in_buckling": {"type": "boolean", "description": "false = applied as preload in buckling steps (self-weight)"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["force", "pressure", "remote_force"]}}},
         "then": {"required": ["faces", "magnitude"]}},
        {"if": {"properties": {"type": {"const": "hydrostatic"}}},
         "then": {"required": ["faces"]}},
        {"if": {"properties": {"type": {"enum": ["force", "gravity", "remote_force"]}}},
         "then": {"required": ["direction", "magnitude"]}}
      ]
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "faces"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["fixed", "displacement", "pinned"]},
        "faces": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "dofs": {
          "type": "array", "items": {"enum": [1, 2, 3]}, "uniqueItems": true,
          "description": "displacement: constrained global directions (zero displacement). pinned: translations held at the face centroid (default all three)"
        },
        "hold_rotations": {
          "type": "array", "items": {"enum": [1, 2, 3]}, "uniqueItems": true,
          "description": "pinned: global rotation axes also held (e.g. [3] stops twisting about Z); others are free"
        }
      }
    },
    "hinge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "faces"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "faces": {"type": "array", "items": {"type": "string"}, "minItems": 1,
                  "description": "face_refs ids: one or more concentric cylindrical faces (holes, pin surfaces); the concentric faces of the other parts along the axis are found"},
        "lock_rotation": {"type": "boolean", "description": "the parts may not turn about the axis: the hinge is bonded"},
        "note": {"type": "string"}
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parts", "connection"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parts": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "interface": {"type": "string", "description": "Interface id from connections.json; absent = applies to every interface between the parts"},
        "connection": {"enum": ["tie", "contact", "none", "revolute", "hinge", "slide", "sliding", "bolted", "screw"]},
        "friction": {"type": "number", "minimum": 0},
        "params": {"type": "object", "description": "Type-specific settings, e.g. sliding: {\"direction\": [x, y, z]} (assembly frame; used before a cylinder axis or mate direction); bolted: size, preload ..."},
        "note": {"type": "string"}
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "load_cases"],
      "properties": {
        "name": {"type": "string"},
        "analyses": {"type": "array", "items": {"enum": ["static", "buckling"]}, "uniqueItems": true},
        "load_cases": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "buckling_cases": {"type": "array", "items": {"type": "string"}},
        "buckling_modes": {"type": "integer", "minimum": 1},
        "load_superposition": {"type": "boolean", "description": "Solve each load on its own once; a load case is then the sum of its loads, so changing only load sizes needs no new solve (linear static only; D39)"},
        "bond_tolerance": {"type": "number", "minimum": 0, "description": "Faces this close (a gap or an overlap, mm) count as touching and are bonded; default 0.5"},
        "connection_method": {"enum": ["auto", "classic", "bond_first"], "description": "How connections are found: bond_first bonds everything touching and keeps a mate's joint only where it frees something (D81); auto chooses bond_first on models with many parts"},
        "excluded_parts": {"type": "array", "items": {"type": "string"}, "description": "Parts left out of the analysis by the user (the floating-parts dialog); never suppressed in SolidWorks"},
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "favour": {"enum": ["speed", "balanced", "accuracy"], "description": "What the run planner favours (D60): it chooses the mesh level, solver and convergence pass from this and the computer's free memory and cores; default balanced"},
            "fidelity": {"enum": ["coarse", "standard", "fine"], "description": "Advanced override of the planner's mesh level"},
            "solver": {"enum": ["auto", "calculix", "hybrid"], "description": "Advanced override of the planner's solver choice; default auto"},
            "size": {"type": "number", "exclusiveMinimum": 0, "description": "Override global element size, mm"},
            "convergence_check": {"type": "boolean", "description": "Advanced override: solve again on a refined mesh and report the change (the planner decides when absent)"},
            "refine_unconverged": {"type": "boolean", "description": "Advanced override: after the two solves, mesh the parts that did not converge finer again and solve a third time (on with Optimise for Accuracy when absent)"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_deflection": {"type": "number", "exclusiveMinimum": 0},
            "min_fos": {"type": "number", "exclusiveMinimum": 0},
            "min_buckling_factor": {"type": "number", "exclusiveMinimum": 0},
            "max_stress": {"type": "number", "exclusiveMinimum": 0, "description": "Allowable von Mises stress, MPa: FAIL when any part's peak away from bonded joints exceeds it (D53)"}
          }
        }
      }
    }
  }
}
